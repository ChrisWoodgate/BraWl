# Mode 301 means run a 3D simulation ('3') using Metropolis-Hastings ('01')
mode=301

# The ideal hcp lattice: hexagonal primitive cell with the ideal axial ratio c/a = sqrt(8/3) and a two-atom basis
lattice = ideal_hcp

# The lattice parameter (the in-plane spacing a)
# This only matters for xyz file output. Internally the code works with normalised coordination shells for a given lattice type
lattice_parameter = 3.21

# Number of primitive cells in directions 1 (a_1), 2 (a_2), and 3 (a_3). Two atoms per cell
n_1=4
n_2=4
n_3=4

# Number of chemical species
n_species = 3

# The species names and numbers of atoms (128 in total)
species_names = A B C
species_numbers = 43 43 42

# The range of the interaction and the file where the parameters can be found
# Note: the interactions in hcp_epi.vij are synthetic values for testing, not fitted to a real alloy
interaction_range = 10
interaction_file = 'hcp_epi.vij'

# N+1, where N is the distance to which you would like to compute conditional pair probabilities, ASRO parameters
wc_range = 4

# Swap just nearest-neighbours (if 'true') or any pair of lattice sites (if 'false')
nbr_swap = .false.

# Use a static seed for the PNRG for testing
static_seed = .true.
